# ── .gitignore : ne versionner que les fichiers utiles au deploiement ──
# Approche allowlist : tout est ignore par defaut, seuls les chemins
# explicitement autorises ci-dessous sont versionnables.

# Ignorer tout a la racine
/*

# Autoriser les fichiers/dossiers necessaires au deploiement de app_v2.py
!/app_v2.py
!/utils/
!/assets/
!/requirements.txt
!/requirements-app.txt
!/data/
!/.gitignore
!/README.md
!/.devcontainer/

# Dans data/, ignorer tout sauf l'echantillon SHAP necessaire au deploiement
/data/*
!/data/processed/
/data/processed/*
!/data/processed/shap_background_sample.parquet

# ── Secrets — jamais commiter, meme dans un dossier autorise ──────
.env
.env.*
secrets.yaml
.streamlit/secrets.toml

# ── Artefacts locaux — jamais commiter, meme dans un dossier autorise ──
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*.pkl
*.joblib
